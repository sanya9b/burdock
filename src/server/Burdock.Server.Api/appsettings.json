{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Pronunciation": {
    "ObjectStore": "FileSystem",
    "StorePath": "data/pronunciation",
    "KokoroBaseUrl": "http://kokoro:8081/",
    "EngineVersion": "kokoro-82m-v1.0",
    "WordSpeed": 0.9,
    "RenderTimeoutSeconds": 60
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Auth": {
    "AccessTokenLifetime": "00:10:00",
    "RefreshTokenLifetime": "30.00:00:00",
    "RefreshTokenReuseLeeway": "00:00:30",
    "AllowInsecureHttp": false
  },
  "RateLimits": {
    "IdentityCreate": "5/01:00:00",
    "Token": "20/00:01:00",
    "AnonIp": "60/00:01:00",
    "User": "120/00:01:00",
    "UserWrite": "60/00:01:00"
  },
  "RemoteConfig": {
    "MinAppVersion": {
      "Ios": "1.0.0",
      "Android": "1.0.0"
    },
    "Features": {
      "liveActivities": false,
      "googleSignIn": false,
      "contentPush": false
    },
    "RulesVersion": "economy-v1"
  },
  "Proxy": {
    "TrustedNetworks": []
  },
  "Content": {
    "ObjectStore": "FileSystem",
    "StorePath": "data/packs",
    "ServeStoreLocally": false,
    "DeprecatedRetentionDays": 180
  },
  "Entitlements": {
    "DefaultState": "Trial"
  }
}
