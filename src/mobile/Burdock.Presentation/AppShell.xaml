<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:Burdock.Presentation.Views"
       xmlns:strings="clr-namespace:Burdock.Presentation.Resources.Strings"
       x:Class="Burdock.Presentation.AppShell"
       Title="{x:Static strings:AppResources.App_Name}"
       FlyoutBehavior="Disabled">
    <!-- Information architecture (spec 03 FR-03-7): four tabs. Route strings live here and in Navigation/Routes.cs only. -->
    <TabBar>
        <Tab Title="{x:Static strings:AppResources.Tab_Today_Title}" Route="today">
            <ShellContent ContentTemplate="{DataTemplate views:TodayPage}" />
        </Tab>
        <Tab Title="{x:Static strings:AppResources.Tab_Learn_Title}" Route="learn">
            <ShellContent ContentTemplate="{DataTemplate views:LearnPage}" />
        </Tab>
        <Tab Title="{x:Static strings:AppResources.Tab_Words_Title}" Route="words">
            <ShellContent ContentTemplate="{DataTemplate views:WordsPage}" />
        </Tab>
        <Tab Title="{x:Static strings:AppResources.Tab_Me_Title}" Route="me">
            <ShellContent ContentTemplate="{DataTemplate views:MePage}" />
        </Tab>
    </TabBar>
</Shell>
