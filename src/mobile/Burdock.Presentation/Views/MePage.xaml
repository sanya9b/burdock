<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Burdock.Presentation.ViewModels"
             xmlns:controls="clr-namespace:Burdock.Presentation.Controls"
             xmlns:icons="clr-namespace:Burdock.Presentation.Resources.Icons"
             xmlns:strings="clr-namespace:Burdock.Presentation.Resources.Strings"
             x:Class="Burdock.Presentation.Views.MePage"
             x:DataType="vm:MeViewModel"
             Shell.NavBarIsVisible="False"
             Title="{x:Static strings:AppResources.Tab_Me_Title}">
    <!-- S-17 «Я» (spec 03): the learner's growing Реп’яшок (spec 07 §3.2.7), level and XP, thorns and streak, achievements (spec 07 §3.6), anonymous learner, settings entry. Account linking and Pro come with phases 2 and 5. -->
    <ScrollView>
        <VerticalStackLayout Spacing="{StaticResource Space5}" Padding="{StaticResource PageInsetScroll}" MaximumWidthRequest="{StaticResource SizeContentMaxWidth}">
            <Label Text="{x:Static strings:AppResources.Me_Title}" Style="{StaticResource TypeHeadlineLg}" SemanticProperties.HeadingLevel="Level1" />

            <!-- Growth hero: one mascot per screen (spec 02 §3.10). The burr grows with XP and never shrinks; without gamification it is the grown-up illustration. -->
            <!-- The chosen scene («Фони») fills the whole stage edge to edge (owner request 14.11.2026): the card has no padding, the Border clips to its corners,
                 and the name and caption sit on the tonal strip below. Without a scene the tonal card shows through. -->
            <Border Style="{StaticResource CardTonal}" Padding="0">
                <VerticalStackLayout Spacing="0">
                    <controls:MascotView x:Name="Mascot" Stage="{Binding GrowthStage}" Progress="{Binding GrowthProgress}" Mood="Proud" Outfit="{Binding Outfit}" AvatarFrame="{Binding Frame}" Scene="{Binding Scene}" Ride="{Binding Ride}"
                                         SceneCornerRadius="0" HeightRequest="{StaticResource SizeMascotStage}" HorizontalOptions="Fill"
                                         SemanticProperties.Description="{Binding GrowthDescription}" SemanticProperties.Hint="{x:Static strings:AppResources.Mascot_A11y_Hint}" />
                    <VerticalStackLayout Spacing="{StaticResource Space2}" Padding="{StaticResource Space4}" IsVisible="{Binding ShowRewards}">
                        <Label Text="{Binding StageName}" Style="{StaticResource TypeHeadlineMd}" HorizontalTextAlignment="Center" SemanticProperties.HeadingLevel="Level2"
                               TextColor="{AppThemeBinding Light={StaticResource ColorBrandOnPrimaryContainerLight}, Dark={StaticResource ColorBrandOnPrimaryContainerDark}}" />
                        <Label Text="{Binding GrowthCaption}" Style="{StaticResource TypeBodySm}" HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource ColorBrandOnPrimaryContainerLight}, Dark={StaticResource ColorBrandOnPrimaryContainerDark}}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Level, XP, thorns, streak -->
            <Border Style="{StaticResource CardElevated}" IsVisible="{Binding ShowRewards}">
                <VerticalStackLayout Spacing="{StaticResource Space3}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space3}">
                        <Label Grid.Column="0" Text="{Binding LevelText}" Style="{StaticResource TypeTitleLg}" />
                        <Label Grid.Column="1" Text="{Binding XpText}" Style="{StaticResource LabelSecondary}" VerticalOptions="Center" />
                    </Grid>
                    <ProgressBar Progress="{Binding XpProgress}" Style="{StaticResource XpBar}" />
                    <HorizontalStackLayout Spacing="{StaticResource Space2}">
                        <Border Style="{StaticResource CurrencyPill}" SemanticProperties.Hint="{x:Static strings:AppResources.Me_Rewards_Row}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenRewardsCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="{StaticResource Space2}">
                                <Image Source="brand_mark.png" WidthRequest="{StaticResource SizeIconMd}" HeightRequest="{StaticResource SizeIconMd}" AutomationProperties.IsInAccessibleTree="False" />
                                <Label Text="{Binding ThornsText}" Style="{StaticResource CurrencyPillText}" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border Style="{StaticResource StreakBadge}">
                            <HorizontalStackLayout Spacing="{StaticResource Space2}">
                                <Label Text="{x:Static icons:Icon.Flame}" Style="{StaticResource IconGlyphSm}"
                                       TextColor="{AppThemeBinding Light={StaticResource ColorStreakActiveLight}, Dark={StaticResource ColorStreakActiveDark}}" />
                                <Label Text="{Binding StreakText}" Style="{StaticResource StreakBadgeText}" />
                            </HorizontalStackLayout>
                        </Border>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardSunken}" Padding="{StaticResource Space4}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space3}">
                    <Border Grid.Column="0" Style="{StaticResource IconWell}" VerticalOptions="Start">
                        <Label Text="{x:Static icons:Icon.UserRound}" Style="{StaticResource IconGlyph}"
                               TextColor="{AppThemeBinding Light={StaticResource ColorBrandPrimaryLight}, Dark={StaticResource ColorBrandPrimaryDark}}" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource Space1}" VerticalOptions="Center">
                        <Label Text="{x:Static strings:AppResources.Me_Anonymous_Title}" Style="{StaticResource TypeTitleMd}" />
                        <Label Text="{x:Static strings:AppResources.Me_Anonymous_Body}" Style="{StaticResource TextTertiary}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Achievements -->
            <VerticalStackLayout Spacing="{StaticResource Space3}" IsVisible="{Binding ShowRewards}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="{x:Static strings:AppResources.Me_Achievements_Title}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
                    <Label Grid.Column="1" Text="{Binding AchievementsSummary}" Style="{StaticResource LabelSecondary}" VerticalOptions="End" />
                </Grid>
                <VerticalStackLayout Spacing="{StaticResource Space2}" BindableLayout.ItemsSource="{Binding AchievementRows}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:AchievementRow">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource Space2}">
                                <Border Grid.Column="0" Style="{StaticResource AchievementTile}" BindingContext="{Binding Left}" x:DataType="vm:AchievementTile" SemanticProperties.Description="{Binding Title}" SemanticProperties.Hint="{Binding Body}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding Unlocked}" Value="False">
                                            <Setter Property="Opacity" Value="{StaticResource OpacityMuted}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space3}">
                                        <Border Grid.Column="0" Style="{StaticResource IconWell}" VerticalOptions="Start">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding Unlocked}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ColorRewardGoldContainerLight}, Dark={StaticResource ColorRewardGoldContainerDark}}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label Text="{Binding Glyph}" Style="{StaticResource IconGlyph}"
                                                   TextColor="{AppThemeBinding Light={StaticResource ColorRewardGoldTextLight}, Dark={StaticResource ColorRewardGoldTextDark}}" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource Space1}" VerticalOptions="Center">
                                            <Label Text="{Binding Title}" Style="{StaticResource TypeLabelMd}" LineBreakMode="WordWrap" />
                                            <Label Text="{Binding Reward}" Style="{StaticResource TextTertiary}" IsVisible="{Binding Unlocked}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource AchievementTile}" BindingContext="{Binding Right}" x:DataType="vm:AchievementTile" IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:AchievementRow}}, Path=HasRight}" SemanticProperties.Description="{Binding Title}" SemanticProperties.Hint="{Binding Body}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding Unlocked}" Value="False">
                                            <Setter Property="Opacity" Value="{StaticResource OpacityMuted}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space3}">
                                        <Border Grid.Column="0" Style="{StaticResource IconWell}" VerticalOptions="Start">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding Unlocked}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ColorRewardGoldContainerLight}, Dark={StaticResource ColorRewardGoldContainerDark}}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label Text="{Binding Glyph}" Style="{StaticResource IconGlyph}"
                                                   TextColor="{AppThemeBinding Light={StaticResource ColorRewardGoldTextLight}, Dark={StaticResource ColorRewardGoldTextDark}}" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource Space1}" VerticalOptions="Center">
                                            <Label Text="{Binding Title}" Style="{StaticResource TypeLabelMd}" LineBreakMode="WordWrap" />
                                            <Label Text="{Binding Reward}" Style="{StaticResource TextTertiary}" IsVisible="{Binding Unlocked}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Rewards: the shop (S-16); hidden without gamification like the pills above -->
            <Border Style="{StaticResource CardElevated}" Padding="{StaticResource Space2}" IsVisible="{Binding ShowRewards}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space3}" Padding="{StaticResource ChipInset}" MinimumHeightRequest="{StaticResource SizePushButtonHeight}"
                      SemanticProperties.Description="{x:Static strings:AppResources.Me_Rewards_Row}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenRewardsCommand}" />
                    </Grid.GestureRecognizers>
                    <Border Grid.Column="0" Style="{StaticResource IconWell}">
                        <Label Text="{x:Static icons:Icon.Gift}" Style="{StaticResource IconGlyph}"
                               TextColor="{AppThemeBinding Light={StaticResource ColorRewardCurrencyLight}, Dark={StaticResource ColorRewardCurrencyDark}}" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource Space1}" VerticalOptions="Center">
                        <Label Text="{x:Static strings:AppResources.Me_Rewards_Row}" Style="{StaticResource TypeTitleMd}" />
                        <Label Text="{x:Static strings:AppResources.Me_Rewards_Row_Hint}" Style="{StaticResource TextTertiary}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="{x:Static icons:Icon.ChevronRight}" Style="{StaticResource IconGlyph}" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource ColorTextTertiaryLight}, Dark={StaticResource ColorTextTertiaryDark}}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardElevated}" Padding="{StaticResource Space2}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space3}" Padding="{StaticResource ChipInset}" MinimumHeightRequest="{StaticResource SizePushButtonHeight}"
                      SemanticProperties.Description="{x:Static strings:AppResources.Me_Settings_Row}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenSettingsCommand}" />
                    </Grid.GestureRecognizers>
                    <Border Grid.Column="0" Style="{StaticResource IconWell}">
                        <Label Text="{x:Static icons:Icon.SlidersHorizontal}" Style="{StaticResource IconGlyph}"
                               TextColor="{AppThemeBinding Light={StaticResource ColorBrandPrimaryLight}, Dark={StaticResource ColorBrandPrimaryDark}}" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource Space1}" VerticalOptions="Center">
                        <Label Text="{x:Static strings:AppResources.Me_Settings_Row}" Style="{StaticResource TypeTitleMd}" />
                        <Label Text="{x:Static strings:AppResources.Me_Settings_Row_Hint}" Style="{StaticResource TextTertiary}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="{x:Static icons:Icon.ChevronRight}" Style="{StaticResource IconGlyph}" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource ColorTextTertiaryLight}, Dark={StaticResource ColorTextTertiaryDark}}" />
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
