<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Burdock.Presentation.Views.EmptyStateView"
             x:Name="Root">
    <!-- EmptyState component (spec 02 section 3.7): title, body, room for the mascot (added with the first illustrations). -->
    <VerticalStackLayout Spacing="{StaticResource Space3}"
                         Padding="{StaticResource Space6}"
                         VerticalOptions="Center"
                         MaximumWidthRequest="{StaticResource SizeContentMaxWidth}">
        <Label Text="{Binding Title, Source={x:Reference Root}}"
               Style="{StaticResource TypeHeadlineMd}"
               HorizontalTextAlignment="Center"
               SemanticProperties.HeadingLevel="Level2" />
        <Label Text="{Binding Body, Source={x:Reference Root}}"
               Style="{StaticResource TypeBodyMd}"
               TextColor="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight}, Dark={StaticResource ColorTextSecondaryDark}}"
               HorizontalTextAlignment="Center" />
    </VerticalStackLayout>
</ContentView>
