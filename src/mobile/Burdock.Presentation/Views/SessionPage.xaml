<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:Burdock.Presentation.ViewModels"
             xmlns:views="clr-namespace:Burdock.Presentation.Views"
             xmlns:controls="clr-namespace:Burdock.Presentation.Controls"
             xmlns:converters="clr-namespace:Burdock.Presentation.Converters"
             xmlns:icons="clr-namespace:Burdock.Presentation.Resources.Icons"
             xmlns:strings="clr-namespace:Burdock.Presentation.Resources.Strings"
             x:Class="Burdock.Presentation.Views.SessionPage"
             x:DataType="vm:SessionViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             Title="{x:Static strings:AppResources.Session_Title}">
    <!-- S-12 «Сесія» (spec 03): close, segmented progress, one exercise at a time, feedback panel with a coloured «Далі» (never automatic). -->
    <ContentPage.Resources>
        <toolkit:IsEqualConverter x:Key="IsEqualConverter" />
        <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        <converters:LemmaFontSizeConverter x:Key="LemmaFontSize" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource Space4}">

        <!-- Top row -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space3}" Padding="{StaticResource PageInsetTop}">
            <controls:PushButton Grid.Column="0" Style="{StaticResource PushIcon}" Icon="{x:Static icons:Icon.X}" Command="{Binding CloseCommand}"
                                 SemanticProperties.Description="{x:Static strings:AppResources.Session_Close_A11y}" />
            <controls:SegmentedProgressBar Grid.Column="1" Total="{Binding ItemCount}" Completed="{Binding CompletedCount}" VerticalOptions="Center"
                                           SemanticProperties.Description="{Binding ProgressText}" />
            <Label Grid.Column="2" Text="{Binding ProgressText}" Style="{StaticResource LabelSecondary}" VerticalOptions="Center" />
        </Grid>

        <ActivityIndicator Grid.Row="1" IsRunning="{Binding State, Converter={StaticResource IsEqualConverter}, ConverterParameter={x:Static vm:ViewState.Loading}}"
                           IsVisible="{Binding State, Converter={StaticResource IsEqualConverter}, ConverterParameter={x:Static vm:ViewState.Loading}}" VerticalOptions="Center" />

        <views:EmptyStateView Grid.Row="1" Title="{x:Static strings:AppResources.Session_Empty_Title}" Body="{x:Static strings:AppResources.Session_Empty_Body}" Mascot="mascot_sleep.png"
                              IsVisible="{Binding State, Converter={StaticResource IsEqualConverter}, ConverterParameter={x:Static vm:ViewState.Empty}}" />

        <ScrollView Grid.Row="1" IsVisible="{Binding State, Converter={StaticResource IsEqualConverter}, ConverterParameter={x:Static vm:ViewState.Ready}}">
            <VerticalStackLayout x:Name="ExerciseHost" Spacing="{StaticResource Space5}" Padding="{StaticResource PageInset}" MaximumWidthRequest="{StaticResource SizeContentMaxWidth}">
                <Label Text="{Binding Prompt}" Style="{StaticResource LabelSecondary}" HorizontalTextAlignment="Center" />
                <Label Text="{Binding Stimulus}" Style="{StaticResource TypeDisplayMd}" FontSize="{Binding Stimulus, Converter={StaticResource LemmaFontSize}}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" IsVisible="{Binding IsMatching, Converter={StaticResource InvertedBoolConverter}}" />
                <Label Text="{Binding StimulusSecondary}" Style="{StaticResource TypeWordIpa}" HorizontalTextAlignment="Center" IsVisible="{Binding IsChoice}"
                       TextColor="{AppThemeBinding Light={StaticResource ColorTextTertiaryLight}, Dark={StaticResource ColorTextTertiaryDark}}" />

                <!-- Choice -->
                <VerticalStackLayout Spacing="{StaticResource Space3}" IsVisible="{Binding IsChoice}" BindableLayout.ItemsSource="{Binding Options}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:OptionViewModel">
                            <controls:PushButton Text="{Binding Text}" Style="{StaticResource QuizOption}"
                                                 Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SessionViewModel}}, Path=ChooseCommand}"
                                                 CommandParameter="{Binding .}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Typed recall -->
                <VerticalStackLayout Spacing="{StaticResource Space3}" IsVisible="{Binding IsTyped}">
                    <Border Style="{StaticResource TypedField}">
                        <Entry Text="{Binding TypedAnswer}" Placeholder="{x:Static strings:AppResources.Session_Typed_Placeholder}"
                               IsEnabled="{Binding Answered, Converter={StaticResource InvertedBoolConverter}}"
                               ReturnType="Done" ReturnCommand="{Binding CheckTypedCommand}"
                               Keyboard="Text" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                               FontFamily="RubikSemiBold" FontSize="{StaticResource FontSizeHeadlineSm}" HorizontalTextAlignment="Center" />
                    </Border>
                    <controls:PushButton Text="{x:Static strings:AppResources.Common_Check_Button}" Icon="{x:Static icons:Icon.Check}" Command="{Binding CheckTypedCommand}"
                                         IsVisible="{Binding Answered, Converter={StaticResource InvertedBoolConverter}}" />
                </VerticalStackLayout>

                <!-- Matching -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource Space3}" IsVisible="{Binding IsMatching}">
                    <VerticalStackLayout Grid.Column="0" Spacing="{StaticResource Space2}" BindableLayout.ItemsSource="{Binding MatchWords}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:OptionViewModel">
                                <controls:PushButton Text="{Binding Text}" Style="{StaticResource MatchTile}"
                                                     Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SessionViewModel}}, Path=PickMatchCommand}"
                                                     CommandParameter="{Binding .}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource Space2}" BindableLayout.ItemsSource="{Binding MatchMeanings}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:OptionViewModel">
                                <controls:PushButton Text="{Binding Text}" Style="{StaticResource MatchTile}"
                                                     Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SessionViewModel}}, Path=PickMatchCommand}"
                                                     CommandParameter="{Binding .}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Combo chip: consecutive correct answers, joy not pressure (spec 07 §3.8) -->
        <Border x:Name="ComboChip" Grid.Row="1" Style="{StaticResource ChipGold}" HorizontalOptions="End" VerticalOptions="Start" Margin="{StaticResource PageInset}"
                IsVisible="{Binding ShowCombo}" SemanticProperties.Description="{Binding ComboAccessibility}">
            <HorizontalStackLayout Spacing="{StaticResource Space1}">
                <Label Text="{x:Static icons:Icon.Flame}" Style="{StaticResource IconGlyphSm}" TextColor="{AppThemeBinding Light={StaticResource ColorStreakActiveLight}, Dark={StaticResource ColorStreakActiveDark}}" />
                <Label Text="{Binding ComboText}" Style="{StaticResource ChipTextGold}" FontFamily="RubikBold" />
            </HorizontalStackLayout>
        </Border>

        <!-- Feedback + Next (slides in from the code-behind) -->
        <VerticalStackLayout x:Name="FeedbackPanel" Grid.Row="2" Spacing="{StaticResource Space3}" Padding="{StaticResource BottomBarInset}" IsVisible="{Binding Answered}"
                             MaximumWidthRequest="{StaticResource SizeContentMaxWidth}">
            <Border Style="{StaticResource FeedbackCard}" SemanticProperties.Description="{Binding Feedback}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space3}">
                    <Label Grid.Column="0" Text="{Binding FeedbackIcon}" Style="{StaticResource FeedbackIcon}" />
                    <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource Space1}">
                        <Label Text="{Binding FeedbackTitle}" Style="{StaticResource FeedbackTitle}" />
                        <Label Text="{Binding FeedbackDetail}" Style="{StaticResource FeedbackDetail}" IsVisible="{Binding HasFeedbackDetail}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
            <controls:PushButton Text="{x:Static strings:AppResources.Common_Next_Button}" Icon="{x:Static icons:Icon.ArrowRight}" Style="{StaticResource FeedbackNext}"
                                 Command="{Binding NextCommand}" IsVisible="{Binding IsLast, Converter={StaticResource InvertedBoolConverter}}" />
            <controls:PushButton Text="{x:Static strings:AppResources.Session_Finish_Button}" Icon="{x:Static icons:Icon.Check}" Style="{StaticResource FeedbackNext}"
                                 Command="{Binding FinishCommand}" IsVisible="{Binding IsLast}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
