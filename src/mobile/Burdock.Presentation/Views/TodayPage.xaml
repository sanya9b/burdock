<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:Burdock.Presentation.ViewModels"
             xmlns:views="clr-namespace:Burdock.Presentation.Views"
             xmlns:controls="clr-namespace:Burdock.Presentation.Controls"
             xmlns:converters="clr-namespace:Burdock.Presentation.Converters"
             xmlns:icons="clr-namespace:Burdock.Presentation.Resources.Icons"
             xmlns:strings="clr-namespace:Burdock.Presentation.Resources.Strings"
             x:Class="Burdock.Presentation.Views.TodayPage"
             x:DataType="vm:TodayViewModel"
             Shell.NavBarIsVisible="False"
             Title="{x:Static strings:AppResources.Tab_Today_Title}">
    <!-- S-10 «Сьогодні» (spec 03): greeting, hero word (twin of the widget scene), strip of the other words, sticky session CTA. Streak, calendar and tasks arrive in phase 4. -->
    <ContentPage.Resources>
        <toolkit:IsEqualConverter x:Key="IsEqualConverter" />
        <converters:TopicColorConverter x:Key="TopicColor" />
        <converters:LemmaFontSizeConverter x:Key="LemmaFontSize" />
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">
        <RefreshView Grid.Row="0" Command="{Binding LoadCommand}" IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}">
            <ScrollView>
                <VerticalStackLayout Spacing="{StaticResource Space5}" Padding="{StaticResource PageInsetTop}" MaximumWidthRequest="{StaticResource SizeContentMaxWidth}">

                    <!-- Header: StreakBadge and CurrencyPill row (hidden in «без гейміфікації»), then greeting -->
                    <VerticalStackLayout Spacing="{StaticResource Space2}" Margin="{StaticResource Space2}">
                        <HorizontalStackLayout Spacing="{StaticResource Space2}" HorizontalOptions="End" IsVisible="{Binding ShowRewards}">
                            <Border Style="{StaticResource StreakBadge}" SemanticProperties.Description="{Binding StreakAccessibility}">
                                <HorizontalStackLayout Spacing="{StaticResource Space1}">
                                    <Label Text="{x:Static icons:Icon.Flame}" Style="{StaticResource IconGlyphSm}"
                                           TextColor="{AppThemeBinding Light={StaticResource ColorStreakInactiveLight}, Dark={StaticResource ColorStreakInactiveDark}}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding StreakCountedToday}" Value="True">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ColorStreakActiveLight}, Dark={StaticResource ColorStreakActiveDark}}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Text="{Binding StreakText}" Style="{StaticResource StreakBadgeText}" />
                                </HorizontalStackLayout>
                            </Border>
                            <Border Style="{StaticResource CurrencyPill}" SemanticProperties.Hint="{x:Static strings:AppResources.Me_Rewards_Row}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenRewardsCommand}" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="{StaticResource Space1}">
                                    <Image Source="brand_mark.png" WidthRequest="{StaticResource SizeIconSm}" HeightRequest="{StaticResource SizeIconSm}" AutomationProperties.IsInAccessibleTree="False" />
                                    <Label Text="{Binding ThornsText}" Style="{StaticResource CurrencyPillText}" />
                                </HorizontalStackLayout>
                            </Border>
                        </HorizontalStackLayout>
                        <Label Text="{Binding Greeting}" Style="{StaticResource TypeDisplayMd}" SemanticProperties.HeadingLevel="Level1" />
                        <Label Text="{Binding LearningDayText}" Style="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>

                    <!-- «Повторимо?» (S-10 review_due, log item 24): a full pack of learned words is due; tonal card, one action -->
                    <Border Style="{StaticResource CardTonal}" Margin="{StaticResource Space2}" IsVisible="{Binding ShowReview}" AutomationId="Today_Review"
                            SemanticProperties.Description="{Binding ReviewBody}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space3}">
                            <Label Grid.Column="0" Text="{x:Static icons:Icon.RefreshCw}" Style="{StaticResource IconGlyph}" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource ColorBrandPrimaryLight}, Dark={StaticResource ColorBrandPrimaryDark}}" />
                            <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource Space1}" VerticalOptions="Center">
                                <Label Text="{x:Static strings:AppResources.Today_Review_Title}" Style="{StaticResource TypeTitleMd}" />
                                <Label Text="{Binding ReviewBody}" Style="{StaticResource TypeBodySm}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <controls:PushButton Grid.Column="2" Style="{StaticResource PushTonal}" Text="{x:Static strings:AppResources.Today_Review_Action}" Command="{Binding StartReviewCommand}"
                                                 VerticalOptions="Center" AutomationId="Today_Review_Start" />
                        </Grid>
                    </Border>

                    <!-- loading: skeleton of the hero and the strip (spec 02 «Skeleton», NFR-03-5); the greeting above is already real -->
                    <VerticalStackLayout Spacing="{StaticResource Space5}" Margin="{StaticResource Space2}" IsVisible="{Binding ShowSkeleton}" SemanticProperties.Description="{x:Static strings:AppResources.Common_Loading}">
                        <controls:Skeleton HeightRequest="{StaticResource SizeSkeletonHero}" CornerRadius="{StaticResource RadiusXl}" />
                        <controls:Skeleton HeightRequest="{StaticResource SizeSkeletonLine}" WidthRequest="{StaticResource SizeSkeletonLineWidth}" HorizontalOptions="Start" />
                        <HorizontalStackLayout Spacing="{StaticResource Space3}">
                            <controls:Skeleton WidthRequest="{StaticResource SizeWordTileWidth}" HeightRequest="{StaticResource SizeWordTileHeight}" CornerRadius="{StaticResource RadiusLg}" />
                            <controls:Skeleton WidthRequest="{StaticResource SizeWordTileWidth}" HeightRequest="{StaticResource SizeWordTileHeight}" CornerRadius="{StaticResource RadiusLg}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- Hero pager (owner request 13.11.2026, log item 25): every word of the day as a hero card, swiped horizontally; the in-app twin of the widget, mascot stuck to the corner (spec 02 section 3.6) -->
                    <Grid IsVisible="{Binding HasWords}" Margin="{StaticResource Space2}" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource Space1}">
                        <CarouselView Grid.Row="0" ItemsSource="{Binding Words}" CurrentItem="{Binding Hero, Mode=TwoWay}" Loop="False" HorizontalScrollBarVisibility="Never"
                                      HeightRequest="{StaticResource SizeHeroPager}" Margin="{StaticResource HeroPagerBleed}" AutomationId="Today_HeroPager">
                            <CarouselView.ItemTemplate>
                                <DataTemplate x:DataType="vm:WordTile">
                                    <Border Style="{StaticResource HeroCard}" Margin="{StaticResource HeroPagerItemInset}" SemanticProperties.Description="{Binding Lemma}" SemanticProperties.Hint="{x:Static strings:AppResources.Today_Hero_Hint}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TodayViewModel}}, Path=OpenWordCommand}" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="{StaticResource Space2}">
                                            <HorizontalStackLayout Spacing="{StaticResource Space2}">
                                                <Border Style="{StaticResource ChipOnHero}">
                                                    <Label Text="{x:Static strings:AppResources.Today_Hero_Eyebrow}" Style="{StaticResource ChipTextOnHero}" />
                                                </Border>
                                                <Border Style="{StaticResource ChipOnHero}">
                                                    <HorizontalStackLayout Spacing="{StaticResource Space1}">
                                                        <Label Text="{Binding ReasonIcon}" Style="{StaticResource IconGlyphSm}" TextColor="{AppThemeBinding Light={StaticResource ColorWidgetChipTextLight}, Dark={StaticResource ColorWidgetChipTextDark}}" />
                                                        <Label Text="{Binding Reason}" Style="{StaticResource ChipTextOnHero}" />
                                                    </HorizontalStackLayout>
                                                </Border>
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding Lemma}" Style="{StaticResource OnHeroWord}" FontSize="{Binding Lemma, Converter={StaticResource LemmaFontSize}}" Margin="{StaticResource InsetTopLg}" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Ipa}" Style="{StaticResource OnHeroIpa}" />
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space2}" Margin="{StaticResource InsetTopMd}">
                                                <Label Grid.Column="0" Text="{x:Static icons:Icon.Eye}" Style="{StaticResource IconGlyphSm}" TextColor="{AppThemeBinding Light={StaticResource ColorWidgetIpaLight}, Dark={StaticResource ColorWidgetIpaDark}}" />
                                                <Label Grid.Column="1" Text="{x:Static strings:AppResources.Today_Hero_Hint}" Style="{StaticResource OnHeroSecondary}" VerticalOptions="Center" LineBreakMode="WordWrap" />
                                                <controls:PushButton Grid.Column="2" Style="{StaticResource PushHeroIcon}" Icon="{x:Static icons:Icon.Volume2}" Margin="{StaticResource Space2}"
                                                                     Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TodayViewModel}}, Path=SpeakWordCommand}" CommandParameter="{Binding .}"
                                                                     SemanticProperties.Description="{x:Static strings:AppResources.Word_Speak_Button}" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CarouselView.ItemTemplate>
                        </CarouselView>
                        <Label Grid.Row="1" Text="{Binding HeroPositionText}" Style="{StaticResource TextTertiary}" HorizontalOptions="Center" IsVisible="{Binding HasMore}"
                               SemanticProperties.Description="{Binding HeroPositionAccessibility}" />
                        <Image Grid.Row="0" Source="mascot_cheer.png" WidthRequest="{StaticResource SizeMascotSm}" HeightRequest="{StaticResource SizeMascotSm}" InputTransparent="True"
                               HorizontalOptions="End" VerticalOptions="Start" Margin="{StaticResource MascotCornerOverhang}" AutomationProperties.IsInAccessibleTree="False" />
                    </Grid>

                    <!-- All words of the day as compact tiles: a tap brings that word into the pager -->
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasMore}">
                        <Label Grid.Column="0" Text="{x:Static strings:AppResources.Today_WordsOfDay_Heading}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
                        <Label Grid.Column="1" Text="{Binding PlanSummary}" Style="{StaticResource TextTertiary}" VerticalOptions="End" />
                    </Grid>
                    <CollectionView ItemsSource="{Binding Words}" IsVisible="{Binding HasMore}" ItemsLayout="HorizontalList"
                                    HeightRequest="{StaticResource SizeWordTileHeight}" SelectionMode="None" Margin="{StaticResource StripBleed}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:WordTile">
                                <Border Style="{StaticResource WordTile}" Margin="{StaticResource StripItemInset}"
                                        BackgroundColor="{Binding TopicKey, Converter={StaticResource TopicColor}}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TodayViewModel}}, Path=SelectWordCommand}" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource Space1}">
                                        <HorizontalStackLayout Grid.Row="0" Spacing="{StaticResource Space1}">
                                            <Label Text="{Binding ReasonIcon}" Style="{StaticResource IconGlyphSm}" TextColor="{Binding TopicKey, Converter={StaticResource TopicColor}, ConverterParameter=on}" />
                                            <Label Text="{Binding Reason}" Style="{StaticResource TypeLabelSm}" VerticalOptions="Center" TextColor="{Binding TopicKey, Converter={StaticResource TopicColor}, ConverterParameter=on}" />
                                        </HorizontalStackLayout>
                                        <Label Grid.Row="1" Text="{Binding Lemma}" Style="{StaticResource TypeTitleLg}" VerticalOptions="End" LineBreakMode="TailTruncation"
                                               TextColor="{Binding TopicKey, Converter={StaticResource TopicColor}, ConverterParameter=on}" />
                                        <Label Grid.Row="2" Text="{Binding Translation}" Style="{StaticResource TypeBodySm}" LineBreakMode="TailTruncation"
                                               TextColor="{Binding TopicKey, Converter={StaticResource TopicColor}, ConverterParameter=on}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <views:EmptyStateView Title="{x:Static strings:AppResources.Today_Empty_Title}" Body="{x:Static strings:AppResources.Today_Empty_Body}" Mascot="mascot_cheer.png"
                                          IsVisible="{Binding State, Converter={StaticResource IsEqualConverter}, ConverterParameter={x:Static vm:ViewState.Empty}}" />

                    <!-- Login calendar and up to three daily tasks (S-10; spec 07 §3.4, §3.5). The calendar is claimed on load (FR-07-9), rows only report
                         progress (no action, no timer); the whole card leads to «Нагороди». Hidden without gamification. -->
                    <Border Style="{StaticResource CardElevated}" Margin="{StaticResource Space2}" IsVisible="{Binding ShowTasks}" AutomationId="Today_Tasks"
                            SemanticProperties.Hint="{x:Static strings:AppResources.Today_Tasks_Hint}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenRewardsCommand}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="{StaticResource Space3}">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="{x:Static strings:AppResources.Today_Tasks_Heading}" Style="{StaticResource SectionTitle}" SemanticProperties.HeadingLevel="Level2" />
                                <Label Grid.Column="1" Text="{x:Static icons:Icon.ChevronRight}" Style="{StaticResource IconGlyphSm}" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource ColorTextTertiaryLight}, Dark={StaticResource ColorTextTertiaryDark}}" AutomationProperties.IsInAccessibleTree="False" />
                            </Grid>
                            <views:CalendarStripView Tiles="{Binding Calendar}" Caption="{Binding CalendarCaption}" />
                            <VerticalStackLayout Spacing="{StaticResource Space3}" BindableLayout.ItemsSource="{Binding Tasks}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TaskRowItem">
                                        <views:TaskRowView />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- goal_done (spec 03 S-10): the day's words are met; Реп'яшок celebrates and offers five more cards. -->
                    <VerticalStackLayout Spacing="{StaticResource Space3}" IsVisible="{Binding State, Converter={StaticResource IsEqualConverter}, ConverterParameter={x:Static vm:ViewState.GoalDone}}">
                        <views:EmptyStateView Title="{x:Static strings:AppResources.Today_GoalDone_Title}" Body="{x:Static strings:AppResources.Today_GoalDone_Body}" Mascot="mascot_party.png" />
                        <controls:PushButton Style="{StaticResource PushAccent}" Text="{x:Static strings:AppResources.Today_GoalDone_Action}" Icon="{x:Static icons:Icon.Plus}" Command="{Binding MoreWordsCommand}"
                                             HorizontalOptions="Center" AutomationId="Today_MoreWords" />
                    </VerticalStackLayout>

                    <Border Style="{StaticResource CardElevated}" IsVisible="{Binding State, Converter={StaticResource IsEqualConverter}, ConverterParameter={x:Static vm:ViewState.Error}}">
                        <VerticalStackLayout Spacing="{StaticResource Space3}">
                            <Label Text="{x:Static strings:AppResources.Common_Error_Title}" Style="{StaticResource TypeTitleMd}" />
                            <controls:PushButton Style="{StaticResource PushTonal}" Text="{x:Static strings:AppResources.Common_Error_Retry}" Icon="{x:Static icons:Icon.RefreshCw}" Command="{Binding LoadCommand}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- Sticky primary action -->
        <Grid Grid.Row="1" Padding="{StaticResource BottomBarInset}">
            <controls:PushButton Text="{x:Static strings:AppResources.Today_StartSession_Button}" Icon="{x:Static icons:Icon.Play}" Command="{Binding StartSessionCommand}"
                                 MaximumWidthRequest="{StaticResource SizeContentMaxWidth}" AutomationId="Today_StartSession" />
        </Grid>
    </Grid>
</ContentPage>
