<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Burdock.Presentation.ViewModels"
             xmlns:controls="clr-namespace:Burdock.Presentation.Controls"
             xmlns:icons="clr-namespace:Burdock.Presentation.Resources.Icons"
             xmlns:strings="clr-namespace:Burdock.Presentation.Resources.Strings"
             x:Class="Burdock.Presentation.Views.SessionSummaryPage"
             x:DataType="vm:SessionSummaryViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             Title="{x:Static strings:AppResources.Summary_Title}">
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False" />
    </Shell.BackButtonBehavior>
    <!-- S-12d (spec 03) + spec 07 §3.8: numbers first, then XP / thorns / streak, then queued celebrations on the RewardCard overlay. Level L2 confetti plays behind the content. -->
    <Grid>
        <controls:ConfettiView x:Name="Confetti" Style="{StaticResource SummaryConfetti}" />
        <Grid RowDefinitions="*,Auto">
            <ScrollView Grid.Row="0">
                <VerticalStackLayout Spacing="{StaticResource Space5}" Padding="{StaticResource Space6}" VerticalOptions="Center" MaximumWidthRequest="{StaticResource SizeContentMaxWidth}">
                    <Image x:Name="MascotImage" Source="{Binding Mascot}" WidthRequest="{StaticResource SizeMascotLg}" HeightRequest="{StaticResource SizeMascotLg}" HorizontalOptions="Center"
                           AutomationProperties.IsInAccessibleTree="False" />
                    <Label Text="{x:Static strings:AppResources.Summary_Title}" Style="{StaticResource TypeHeadlineLg}" HorizontalTextAlignment="Center" SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="{x:Static strings:AppResources.Summary_Encouragement}" Style="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space5}" HorizontalOptions="Center" Margin="{StaticResource Space2}">
                        <Grid Grid.Column="0" WidthRequest="{StaticResource SizeProgressRingLg}" HeightRequest="{StaticResource SizeProgressRingLg}" SemanticProperties.Description="{Binding AccuracyText}">
                            <controls:ProgressRing Value="{Binding Accuracy}" />
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                                <Label Text="{Binding AccuracyPercentText}" Style="{StaticResource TypeNumericStat}" HorizontalTextAlignment="Center" />
                                <Label Text="{x:Static strings:AppResources.Summary_Accuracy_Caption}" Style="{StaticResource TextTertiary}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Grid>
                        <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource Space3}" VerticalOptions="Center">
                            <Border Style="{StaticResource ChipTonal}">
                                <HorizontalStackLayout Spacing="{StaticResource Space2}">
                                    <Label Text="{x:Static icons:Icon.ListChecks}" Style="{StaticResource IconGlyphSm}"
                                           TextColor="{AppThemeBinding Light={StaticResource ColorBrandOnPrimaryContainerLight}, Dark={StaticResource ColorBrandOnPrimaryContainerDark}}" />
                                    <Label Text="{Binding GradedText}" Style="{StaticResource ChipTextTonal}" />
                                </HorizontalStackLayout>
                            </Border>
                            <Border Style="{StaticResource ChipSuccess}">
                                <HorizontalStackLayout Spacing="{StaticResource Space2}">
                                    <Label Text="{x:Static icons:Icon.CircleCheck}" Style="{StaticResource IconGlyphSm}"
                                           TextColor="{AppThemeBinding Light={StaticResource ColorFeedbackOnSuccessContainerLight}, Dark={StaticResource ColorFeedbackOnSuccessContainerDark}}" />
                                    <Label Text="{Binding CorrectText}" Style="{StaticResource ChipTextSuccess}" />
                                </HorizontalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Economy (hidden in «без гейміфікації») -->
                    <Border x:Name="RewardsCard" Style="{StaticResource CardElevated}" IsVisible="{Binding ShowRewards}">
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource Space3}">
                            <VerticalStackLayout Grid.Column="0" Spacing="{StaticResource Space1}" HorizontalOptions="Center">
                                <Label Text="{x:Static icons:Icon.Zap}" Style="{StaticResource IconGlyph}" HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource ColorBrandPrimaryVividLight}, Dark={StaticResource ColorBrandPrimaryVividDark}}" />
                                <Label Text="{Binding XpGainedText}" Style="{StaticResource TypeTitleLg}" HorizontalTextAlignment="Center" />
                                <Label Text="{Binding LevelText}" Style="{StaticResource TextTertiary}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" MaxLines="2" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource Space1}" HorizontalOptions="Center">
                                <Image Source="brand_mark.png" WidthRequest="{StaticResource SizeIconLg}" HeightRequest="{StaticResource SizeIconLg}" HorizontalOptions="Center" AutomationProperties.IsInAccessibleTree="False" />
                                <Label x:Name="ThornsLabel" Text="{Binding ThornsTotal}" Style="{StaticResource TypeTitleLg}" HorizontalTextAlignment="Center" />
                                <Label Text="{Binding ThornsGainedText}" Style="{StaticResource TextTertiary}" HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource ColorRewardCurrencyTextLight}, Dark={StaticResource ColorRewardCurrencyTextDark}}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="{StaticResource Space1}" HorizontalOptions="Center">
                                <Label x:Name="FlameIcon" Text="{x:Static icons:Icon.Flame}" Style="{StaticResource IconGlyph}" HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource ColorStreakActiveLight}, Dark={StaticResource ColorStreakActiveDark}}" />
                                <Label Text="{Binding StreakLength}" Style="{StaticResource TypeTitleLg}" HorizontalTextAlignment="Center" />
                                <Label Text="{x:Static strings:AppResources.Rewards_Streak_Label}" Style="{StaticResource TextTertiary}" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Learning day: gold when counted, neutral when not yet -->
                    <Border Style="{StaticResource CardSunken}" Padding="{StaticResource Space4}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding LearningDayCounted}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ColorRewardGoldContainerLight}, Dark={StaticResource ColorRewardGoldContainerDark}}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <HorizontalStackLayout Spacing="{StaticResource Space3}">
                            <Label Style="{StaticResource IconGlyphLg}" Text="{x:Static icons:Icon.Calendar}"
                                   TextColor="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight}, Dark={StaticResource ColorTextSecondaryDark}}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding LearningDayCounted}" Value="True">
                                        <Setter Property="Text" Value="{x:Static icons:Icon.CalendarCheck}" />
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ColorRewardGoldTextLight}, Dark={StaticResource ColorRewardGoldTextDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Text="{Binding LearningDayText}" Style="{StaticResource TypeTitleMd}" VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding LearningDayCounted}" Value="True">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ColorRewardGoldTextLight}, Dark={StaticResource ColorRewardGoldTextDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <Grid Grid.Row="1" Padding="{StaticResource BottomBarInset}">
                <controls:PushButton Text="{x:Static strings:AppResources.Summary_BackToToday_Button}" Icon="{x:Static icons:Icon.ArrowRight}" Command="{Binding BackToTodayCommand}"
                                     MaximumWidthRequest="{StaticResource SizeContentMaxWidth}" />
            </Grid>
        </Grid>

        <controls:CelebrationOverlay x:Name="Celebration" Item="{Binding CurrentCelebration}" DismissCommand="{Binding DismissCelebrationCommand}" />
    </Grid>
</ContentPage>
