<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Burdock.Presentation.ViewModels"
             xmlns:views="clr-namespace:Burdock.Presentation.Views"
             xmlns:controls="clr-namespace:Burdock.Presentation.Controls"
             xmlns:icons="clr-namespace:Burdock.Presentation.Resources.Icons"
             xmlns:strings="clr-namespace:Burdock.Presentation.Resources.Strings"
             x:Class="Burdock.Presentation.Views.LearnPage"
             x:DataType="vm:LearnViewModel"
             Shell.NavBarIsVisible="False"
             Title="{x:Static strings:AppResources.Tab_Learn_Title}">
    <!-- S-13 «Вчити» (spec 03): session launcher; focus session and statistics arrive later. -->
    <Grid RowDefinitions="Auto,*,Auto">
        <Label Grid.Row="0" Text="{x:Static strings:AppResources.Learn_Title}" Style="{StaticResource TypeHeadlineLg}" Padding="{StaticResource PageInsetTop}" SemanticProperties.HeadingLevel="Level1" />
        <views:EmptyStateView Grid.Row="1" Title="{x:Static strings:AppResources.Learn_Empty_Title}" Body="{x:Static strings:AppResources.Learn_Empty_Body}" Mascot="mascot_think.png" />
        <VerticalStackLayout Grid.Row="2" Spacing="{StaticResource Space3}" Padding="{StaticResource BottomBarInset}" MaximumWidthRequest="{StaticResource SizeContentMaxWidth}">
            <controls:PushButton Style="{StaticResource PushTonal}" Text="{x:Static strings:AppResources.Learn_StartQuick_Button}" Icon="{x:Static icons:Icon.Zap}" Command="{Binding StartQuickCommand}" />
            <controls:PushButton Text="{x:Static strings:AppResources.Learn_StartFull_Button}" Icon="{x:Static icons:Icon.Play}" Command="{Binding StartFullCommand}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
