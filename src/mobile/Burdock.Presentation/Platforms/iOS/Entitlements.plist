<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Spec 04 §3.1.2: the App Group shared with BurdockWidgets. Applied only with -p:BurdockWidgets=true, because the
	     provisioning profile must carry the same capability (owner enables App Groups in the developer portal first). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.org.burdock.app</string>
	</array>
</dict>
</plist>
