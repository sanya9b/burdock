<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ system splash (spec 03 S-01, ADR 0018): our animated mark (drawable-v31/burdock_splash_anim, generated by
    design/mascot/build_brand_assets.py) on the widget background colour. Keeps MAUI's maui_splash marker and the legacy
    windowBackground so MauiAppCompatActivity still switches to Maui.MainTheme after launch.
-->
<resources>
    <style name="Maui.SplashTheme" parent="Maui.MainTheme.NoActionBar">
        <item name="maui_splash">true</item>
        <item name="android:windowBackground">@drawable/maui_splash</item>
        <item name="android:windowSplashScreenBackground">@color/burdock_widget_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/burdock_splash_anim</item>
        <item name="android:windowSplashScreenAnimationDuration">1000</item>
    </style>
</resources>
