<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds reach the developer API over plain HTTP at the emulator host alias; every other host stays HTTPS-only (spec 10 section 3.3). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
