<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Burdock.Presentation.Controls"
             x:Class="Burdock.Presentation.Controls.TopBar"
             x:Name="Root">
    <!-- TopBar (spec 02 section 3.11): our own header instead of the platform navigation bar; leading icon button, centred title, optional trailing view. -->
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space3}" MinimumHeightRequest="{StaticResource SizePushButtonHeight}">
        <controls:PushButton Grid.Column="0"
                             Style="{StaticResource PushIcon}"
                             Icon="{Binding LeadingIcon, Source={x:Reference Root}}"
                             Command="{Binding LeadingCommand, Source={x:Reference Root}}"
                             IsVisible="{Binding HasLeading, Source={x:Reference Root}}"
                             SemanticProperties.Description="{Binding LeadingDescription, Source={x:Reference Root}}"
                             VerticalOptions="Center" />
        <Label Grid.Column="1"
               Text="{Binding Title, Source={x:Reference Root}}"
               Style="{StaticResource TypeTitleLg}"
               HorizontalTextAlignment="Center"
               VerticalOptions="Center"
               LineBreakMode="TailTruncation"
               SemanticProperties.HeadingLevel="Level1" />
        <ContentView Grid.Column="2"
                     Content="{Binding Trailing, Source={x:Reference Root}}"
                     MinimumWidthRequest="{StaticResource SizeTouchTargetMin}"
                     VerticalOptions="Center" />
    </Grid>
</ContentView>
