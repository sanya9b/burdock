<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Burdock.Presentation.Controls"
             xmlns:icons="clr-namespace:Burdock.Presentation.Resources.Icons"
             xmlns:strings="clr-namespace:Burdock.Presentation.Resources.Strings"
             x:Class="Burdock.Presentation.Controls.StepperRow"
             x:Name="Root">
    <!-- Stepper (spec 02 section 3.11): title, current value with unit, two round icon buttons of 44/48 pt. -->
    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="{StaticResource Space2}" MinimumHeightRequest="{StaticResource SizePushButtonHeight}">
        <Label Grid.Column="0" Text="{Binding Title, Source={x:Reference Root}}" Style="{StaticResource TypeTitleMd}" VerticalOptions="Center" LineBreakMode="WordWrap" />
        <controls:PushButton Grid.Column="1" Style="{StaticResource PushIcon}" Icon="{x:Static icons:Icon.Minus}" Command="{Binding DecrementCommand, Source={x:Reference Root}}"
                             SemanticProperties.Description="{x:Static strings:AppResources.Settings_Decrease_A11y}" />
        <Label Grid.Column="2" Text="{Binding ValueText, Source={x:Reference Root}}" Style="{StaticResource TypeNumericStat}" FontSize="{StaticResource FontSizeHeadlineSm}"
               HorizontalTextAlignment="Center" VerticalOptions="Center" MinimumWidthRequest="{StaticResource SizeTouchTargetMin}" />
        <controls:PushButton Grid.Column="3" Style="{StaticResource PushIcon}" Icon="{x:Static icons:Icon.Plus}" Command="{Binding IncrementCommand, Source={x:Reference Root}}"
                             SemanticProperties.Description="{x:Static strings:AppResources.Settings_Increase_A11y}" />
    </Grid>
</ContentView>
