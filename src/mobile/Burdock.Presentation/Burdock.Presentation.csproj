<Project Sdk="Microsoft.NET.Sdk">
  <!-- MAUI head: XAML, ViewModels, navigation and the composition root (spec 01 section 3.1). Business rules never live here. -->
  <PropertyGroup>
    <!-- net10.0 is the platform-neutral head for ViewModel tests (spec 15 section 3.7); Android everywhere; iOS only on macOS
         (no Mac locally, decision Q6/Q16: iOS is built by ci-ios). -p:BurdockTargets overrides for CI runners. -->
    <TargetFrameworks>net10.0;net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net10.0-ios</TargetFrameworks>
    <TargetFrameworks Condition="'$(BurdockTargets)' != ''">$(BurdockTargets)</TargetFrameworks>
    <OutputType Condition="'$(TargetFramework)' != 'net10.0'">Exe</OutputType>
    <RootNamespace>Burdock.Presentation</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    <NeutralLanguage>uk</NeutralLanguage>

    <!-- Store identity (decision Q27). The display name is localized through MauiInfoPlist/Android resources; the Ukrainian title is set in Platforms. -->
    <ApplicationTitle>Burdock</ApplicationTitle>
    <ApplicationId>org.burdock.app</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Platform floors (decisions Q25, T2). -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">16.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>

    <!-- The MAUI template emits a few analyzer findings we do not control (generated code); keep the rest of the repo strict. -->
    <NoWarn>$(NoWarn);CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Brand mark (spec 02 section 3.2, ADR 0018): SVGs generated by design/mascot/build_brand_assets.py; colours = color.widget.background (violet.600) / violet.800 gradient.
         ForegroundScale keeps the burr inside the Android adaptive-icon safe zone; on Android 12+ the splash icon is the animated vector in Platforms/Android/Resources/drawable-v31. -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" ForegroundScale="0.8" Color="#6D49EB" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#6D49EB" BaseSize="160,160" />
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Bundled content packs (spec 08 section 3.10): single source of truth lives in content/seed, linked into the package as content/<file>. -->
    <MauiAsset Include="..\..\..\content\seed\*.json" LogicalName="content/%(Filename)%(Extension)" Link="Resources\Raw\content\%(Filename)%(Extension)" />
    <!-- Generated content packs (spec 08 §3.10): built by content/pipeline/packs/build_packs.py; index.json lists them for the bundled source. -->
    <MauiAsset Include="..\..\..\content\generated\uk-en\packs\*.json" LogicalName="content/packs/%(Filename)%(Extension)" Link="Resources\Raw\content\packs\%(Filename)%(Extension)" />
    <!-- Seed pronunciation audio (ADR 0019): rendered by `burdock-content audio render`, one folder per voice plus audio-index.json. -->
    <MauiAsset Include="..\..\..\content\seed\audio\**\*" LogicalName="content/audio/%(RecursiveDir)%(Filename)%(Extension)" Link="Resources\Raw\content\audio\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI strings: neutral culture uk, strongly typed accessor generated at build (spec 12 section 3.2). -->
    <EmbeddedResource Update="Resources\Strings\AppResources.resx">
      <StronglyTypedFileName>$(IntermediateOutputPath)AppResources.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>Burdock.Presentation.Resources.Strings</StronglyTypedNamespace>
      <StronglyTypedClassName>AppResources</StronglyTypedClassName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Burdock.Presentation.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\shared\Burdock.Domain\Burdock.Domain.csproj" />
    <ProjectReference Include="..\Burdock.Application\Burdock.Application.csproj" />
    <ProjectReference Include="..\Burdock.Infrastructure\Burdock.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CommunityToolkit.Maui" />
  </ItemGroup>
</Project>
